# ── LINE ─────────────────────────────────────────────
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# ── Supabase ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── 送貨路線規劃 ───────────────────────────────────────
# 訂單資料表名稱（預設 gas_order，就是 LIFF 下單寫入的那張表）
ORDERS_TABLE=gas_order

# Google 地圖金鑰（選填）
#   有設定：地址定位改用 Google Geocoding，路線順序改用 Directions API（依實際道路）
#   沒設定：改用免金鑰的 OpenStreetMap／Nominatim + 內建 TSP 演算法，功能一樣可用
GOOGLE_MAPS_API_KEY=

# 地理編碼服務：auto（預設，有金鑰用 google）/ google / nominatim
GEOCODER=auto
GEOCODE_REGION=tw
GEOCODE_LANGUAGE=zh-TW

# 瓦斯行（車庫）位置，當師傅沒開定位時作為路線起點
DEPOT_NAME=瓦斯行
DEPOT_ADDRESS=
DEPOT_LAT=
DEPOT_LNG=

# 里程與時間估算參數
ROAD_DISTANCE_FACTOR=1.3    # 直線距離換算道路里程的倍率
AVERAGE_SPEED_KMH=25        # 市區平均車速
SERVICE_MINUTES_PER_STOP=6  # 每一站搬瓦斯／收款的時間
TZ_OFFSET_HOURS=8           # 當日訂單篩選使用的時區
